# ============================================================
# Security24h Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Database (Prisma — SQL Server, ERP READ-ONLY) ---
# Format: sqlserver://HOST:PORT;database=DBNAME;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL=

# --- Database (TypeORM legacy — used by Auth/Leads/Quotes) ---
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
SQL_SERVER_DATABASE=
SQL_SERVER_ENCRYPT=false

# --- App Database (Postgres — dados próprios do app) ---
# Se vazio, fallback para SQLite local em apps/backend/data/app.sqlite.
# Dev (docker-compose):   postgresql://sec24h:sec24h_dev@localhost:5432/sec24h_app
# Prod (EasyPanel):        postgresql://USER:PASS@HOST:5432/DB
APP_DATABASE_URL=

# Diretório onde fotos são salvas (volume persistente em prod).
# Dev: deixar vazio → usa apps/backend/data/photos
# Prod: /data/photos (montado via EasyPanel volume)
PHOTOS_DIR=

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Server ---
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Role Mapping (comma-separated usernames per role) ---
# Users not listed in any role default to VENDEDOR
ADMIN_USERS=admin,gestor
GESTOR_USERS=
SDR_USERS=
VENDEDOR_USERS=
TECNICO_USERS=
