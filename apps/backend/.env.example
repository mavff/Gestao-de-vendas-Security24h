# ============================================================
# Security24h Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Database (Prisma — SQL Server) ---
# Format: sqlserver://HOST:PORT;database=DBNAME;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL=

# --- Database (TypeORM legacy — used by Auth/Leads/Quotes) ---
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
SQL_SERVER_DATABASE=
SQL_SERVER_ENCRYPT=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Server ---
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Admin Users (comma-separated usernames that get ADMIN role) ---
ADMIN_USERS=admin,gestor
