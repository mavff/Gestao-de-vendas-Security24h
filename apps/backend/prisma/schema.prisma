// Security24h — Prisma Schema (SQL Server)
// Mapeamento parcial das tabelas do sistema legado.
// Apenas tabelas usadas pela API read-only estão modeladas.
// Referencia completa: /tabelas.md + /docs/DB_MAPPING.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ============================================================
// Produtos (Equipment)
// ============================================================

model Produto {
  codProduto         Int      @id @map("CodProduto")
  descricao          String?  @map("Descriçao") @db.NVarChar(200)
  codFabricante      String?  @map("CodFabricante") @db.NVarChar(50)
  codMarca           Int?     @map("CodMarca")
  codGrupo           Int?     @map("CodGrupo")
  codSubGrupo        Int?     @map("CodSubGrupo")
  codCategoria       Int?     @map("CodCategoria")
  preco              Decimal? @map("Preço") @db.Decimal(18, 2)
  foto               String?  @map("Foto") @db.NVarChar(500)
  cancelado          Boolean? @default(false) @map("Cancelado")
  pontos             Int?     @map("Pontos")
  produtoKit         Boolean? @map("ProdutoKit")
  acrescimoInstalacao Decimal? @map("AcréscimoInstalação") @db.Decimal(18, 2)
  acrescimoMensal    Decimal? @map("AcréscimoMensal") @db.Decimal(18, 2)
  ncm                String?  @map("NCM") @db.NVarChar(20)
  grupoOrcamento     String?  @map("GrupoOrçamento") @db.NVarChar(50)
  dataCadastro       DateTime? @map("DataCadastro") @db.DateTime
  modeloFabricante   String?  @map("ModeloFabricante") @db.NVarChar(100)
  codUnidade         Int?     @map("CodUnidade")
  estoquePadrao      Int?     @map("EstoquePadrão")

  // Relations
  kitItens           ProdutoKit[] @relation("KitMaster")
  kitPertence        ProdutoKit[] @relation("KitItem")
  preOrcamentosItens PreOrcamentoProduto[]

  @@map("Produtos")
}

// ============================================================
// TiposEstoque (vendas, comodato, insumos, técnico etc.)
// ============================================================

model TipoEstoque {
  codEstoque   Int      @id @map("CodEstoque")
  tipoEstoque  String?  @map("TipoEstoque") @db.NVarChar(100)
  inativo      Boolean? @default(false) @map("Inativo")
  unidade      Int?     @map("Unidade")

  @@map("TiposEstoque")
}

// ============================================================
// ProdutosKits (Kit Composition)
// ============================================================

model ProdutoKit {
  codInterno         Int      @id @map("CodInterno")
  codProdutoKit      Int      @map("CodProdutoKit")
  codProdutoAgregado Int      @map("CodProdutoAgregado")
  quantidade         Decimal  @map("Quantidade") @db.Decimal(18, 2)
  percentual         Decimal? @map("Percentual") @db.Decimal(18, 2)

  // Relations
  kitMaster          Produto  @relation("KitMaster", fields: [codProdutoKit], references: [codProduto], onDelete: NoAction, onUpdate: NoAction)
  itemProduto        Produto  @relation("KitItem", fields: [codProdutoAgregado], references: [codProduto], onDelete: NoAction, onUpdate: NoAction)

  @@map("ProdutosKits")
}

// ============================================================
// Prospects (Leads / Pipeline)
// ============================================================

model Prospect {
  codProspect   Int       @id @map("CodProspect")
  nome          String    @map("Nome") @db.NVarChar(200)
  email         String?   @map("Email") @db.NVarChar(200)
  fone1         String?   @map("Fone1") @db.NVarChar(50)
  endereco      String?   @map("Endereço") @db.NVarChar(200)
  cidade        String?   @map("Cidade") @db.NVarChar(100)
  estado        String?   @map("Estado") @db.NVarChar(2)
  cep           String?   @map("CEP") @db.NVarChar(10)
  vendedor      Int?      @map("Vendedor")
  origem        Int?      @map("Origem")
  status        String    @default("A") @map("Status") @db.Char(1)
  dataCadastro  DateTime? @map("DataCadastro") @db.DateTime
  inativo       Boolean?  @map("Inativo")
  cpf           String?   @map("CPF") @db.NVarChar(20)
  latitude      Decimal?  @map("Latitude") @db.Decimal(12, 8)
  longitude     Decimal?  @map("Longitude") @db.Decimal(12, 8)
  acompanhaPipe Boolean?  @default(false) @map("AcompanhaPipe")
  usuario       String?   @map("Usuário") @db.NVarChar(50)

  // Relations
  acoes         ProspectAcaoVenda[]

  @@map("Prospects")
}

// ============================================================
// ProspectsAcaoVendas (Lead Timeline)
// ============================================================

model ProspectAcaoVenda {
  codAcao       Int       @id @map("CodAção")
  codProspect   Int       @map("CodProspect")
  data          DateTime? @map("Data") @db.DateTime
  hora          String?   @map("Hora") @db.NVarChar(10)
  descricao     String?   @map("Descrição") @db.NVarChar(4000)
  acao          Int?      @map("Ação")
  vendedor      Int?      @map("Vendedor")
  probabilidade Int?      @map("Probabilidade")

  // Relations
  prospect      Prospect  @relation(fields: [codProspect], references: [codProspect], onDelete: NoAction, onUpdate: NoAction)

  @@map("ProspectsAçãoVendas")
}

// ============================================================
// EtapasOrcamento (Pipeline Stages)
// ============================================================

model EtapaOrcamento {
  codInterno   Int      @id @map("CodInterno")
  usuario      String?  @map("Usuário") @db.NVarChar(50)
  unidade      Int?     @map("Unidade")
  etapa        String?  @map("Etapa") @db.NVarChar(100)
  ordem        Int?     @map("Ordem")
  corEtapa     String?  @map("CorEtapa") @db.NVarChar(20)
  descrEtapa   String?  @map("DescrEtapa") @db.NVarChar(500)

  @@map("EtapasOrçamento")
}

// ============================================================
// DadosEntidades (Generic Lookup)
// ============================================================

model DadoEntidade {
  codInterno  Int      @id @map("CodInterno")
  codEntidade Int      @map("CodEntidade")
  codigo      Int?     @map("Codigo")
  descreve    String?  @map("Descreve") @db.NVarChar(200)
  inativa     Boolean? @default(false) @map("Inativa")

  @@map("DadosEntidades")
}

// ============================================================
// Orçamentos (Quotes)
// ============================================================

model Orcamento {
  codInterno          Int       @id @map("CodInterno")
  numOrcamento        Int?      @map("NumOrçamento")
  clienteNome         String?   @map("ClienteNome") @db.NVarChar(200)
  cgcCpf              String?   @map("CGCCPF") @db.NVarChar(20)
  endereco            String?   @map("Endereço") @db.NVarChar(200)
  bairro              String?   @map("Bairro") @db.NVarChar(100)
  cidade              String?   @map("Cidade") @db.NVarChar(100)
  uf                  String?   @map("UF") @db.NVarChar(2)
  cep                 String?   @map("CEP") @db.NVarChar(10)
  fone                String?   @map("Fone") @db.NVarChar(50)
  email               String?   @map("Email") @db.NVarChar(200)
  cliente             Int?      @map("Cliente")
  prospect            Int?      @map("Prospect")
  empresa             Int?      @map("Empresa")
  vendedor            Int?      @map("Vendedor")
  usuario             String?   @map("Usuário") @db.NVarChar(50)
  emissao             DateTime? @map("Emissão") @db.DateTime
  validade            DateTime? @map("Validade") @db.DateTime
  fechamento          DateTime? @map("Fechamento") @db.DateTime
  liberacao           DateTime? @map("Liberação") @db.DateTime
  encerramento        DateTime? @map("Encerramento") @db.DateTime
  dataCancelamento    DateTime? @map("DataCancelamento") @db.DateTime
  formaPagto          Int?      @map("FormaPagto")
  condicaoPagto       Int?      @map("CondiçãoPagto")
  status              String    @default("A") @map("Status") @db.Char(1)
  modalidade          String?   @map("Modalidade") @db.Char(1)
  pontos              Int?      @map("Pontos")
  pDesconto           Decimal?  @map("PDesconto") @db.Decimal(18, 2)
  desconto            Decimal?  @map("Desconto") @db.Decimal(18, 2)
  comissao            Decimal?  @map("Comissão") @db.Decimal(18, 2)
  valorMonitoramento  Decimal?  @map("ValorMonitoramento") @db.Decimal(18, 2)
  totalProdutos       Decimal?  @map("TotalProdutos") @db.Decimal(18, 2)
  totalServicos       Decimal?  @map("TotalServiços") @db.Decimal(18, 2)
  observacoes         String?   @map("Observações") @db.NVarChar(4000)
  etapa               String?   @map("Etapa") @db.NVarChar(100)
  probabilidade       Int?      @map("ProbabilidadeOrçamento")
  hashTag             String?   @map("HashTag") @db.NVarChar(100)
  motivoCancelamento  Int?      @map("MotivoCancelamento")
  planilha            Int?      @unique @map("Planílha")
  codContato          Int?      @map("CodContato")
  codCampanha         Int?      @map("CodCampanha")
  codTabela           Int?      @map("CodTabela")

  // Relations
  produtos            OrcamentoProduto[]
  servicosAdicionais  OrcamentoServicoAdicional[]

  @@map("Orçamentos")
}

// ============================================================
// OrçamentosProdutos (Quote Line Items)
// ============================================================

model OrcamentoProduto {
  codInterno       Int      @id @map("CodInterno")
  planilha         Int      @map("Planílha")
  codProduto       Int?     @map("CodProduto")
  descricao        String?  @map("Descrição") @db.NVarChar(200)
  quantidade       Decimal? @map("Quantidade") @db.Decimal(18, 2)
  unitario         Decimal? @map("Unitário") @db.Decimal(18, 2)
  total            Decimal? @map("Total") @db.Decimal(18, 2)
  liquido          Decimal? @map("Líquido") @db.Decimal(18, 2)
  contaPontos      Boolean? @map("ContaPontos")
  quantidadePontos Int?     @map("QuantidadePontos")
  grupoOrcamento   String?  @map("GrupoOrçamento") @db.NVarChar(50)
  localInstalacao  String?  @map("LocalInstalação") @db.NVarChar(200)

  // Relation via Planílha (Orcamento.planilha)
  orcamento        Orcamento @relation(fields: [planilha], references: [planilha], onDelete: NoAction, onUpdate: NoAction)

  @@map("OrçamentosProdutos")
}

// ============================================================
// OrçamentosServiçosAdicionais (Quote Additional Services)
// ============================================================

model OrcamentoServicoAdicional {
  codInterno     Int      @id @map("CodInterno")
  planilha       Int      @map("Planílha")
  codServico     Int?     @map("CodServiço")
  valorServico   Decimal? @map("ValorServiço") @db.Decimal(18, 2)
  manutencao     Boolean? @map("Manutenção")
  observacoes    String?  @map("Observações") @db.NVarChar(500)
  quantidade     Decimal? @map("Quantidade") @db.Decimal(18, 2)
  descontoTotal  Decimal? @map("DescontoTotal") @db.Decimal(18, 2)

  // Relation via Planílha
  orcamento      Orcamento @relation(fields: [planilha], references: [planilha], onDelete: NoAction, onUpdate: NoAction)

  @@map("OrçamentosServiçosAdicionais")
}

// ============================================================
// Clientes (Clients / Vendors / Technicians — multi-role)
// ============================================================

model Cliente {
  codCliente          Int       @id @map("CodCliente")
  nome                String    @map("Nome") @db.NVarChar(200)
  fantasia            String?   @map("Fantasia") @db.NVarChar(200)
  cgcCpf              String?   @map("CGCCPF") @db.NVarChar(20)
  inscricaoEstadual   String?   @map("InscriçãoEstadual") @db.NVarChar(30)
  endereco            String?   @map("Endereço") @db.NVarChar(200)
  numCasa             String?   @map("NumCasa") @db.NVarChar(20)
  bairro              String?   @map("Bairro") @db.NVarChar(100)
  cidade              String?   @map("Cidade") @db.NVarChar(100)
  estado              String?   @map("Estado") @db.NVarChar(2)
  cep                 String?   @map("CEP") @db.NVarChar(10)
  fone1               String?   @map("Fone1") @db.NVarChar(50)
  fone2               String?   @map("Fone2") @db.NVarChar(50)
  celular             String?   @map("Celular") @db.NVarChar(50)
  email               String?   @map("Email") @db.NVarChar(200)
  tipo                String?   @map("Tipo") @db.Char(1)
  dataCadastro        DateTime? @map("DataCadastro") @db.DateTime
  modalidade          String?   @map("Modalidade") @db.Char(1)
  empresa             Int?      @map("Empresa")
  unidade             Int?      @map("Unidade")
  vendedor            Int?      @map("Vendedor")
  tecnico             Int?      @map("Técnico")
  area                Int?      @map("Área")
  valorNF             Decimal?  @map("ValorNF") @db.Decimal(18, 2)
  cancelamento        DateTime? @map("Cancelamento") @db.DateTime
  latitude            Decimal?  @map("Latitude") @db.Decimal(12, 8)
  longitude           Decimal?  @map("Longitude") @db.Decimal(12, 8)
  pontosAlarme        Int?      @map("PontosAlarme")
  nivelSeguranca      String?   @map("NívelSegurança") @db.Char(1)

  @@map("Clientes")
}

// ============================================================
// OSs (Service Orders)
// ============================================================

model OrdemServico {
  codInterno      Int       @id @map("CodInterno")
  ordem           Int?      @map("Ordem")
  cliente         Int?      @map("Cliente")
  tecnico         Int?      @map("Técnico")
  vendedor        Int?      @map("Vendedor")
  status          String?   @map("Status") @db.Char(1)
  tipo            String?   @map("Tipo") @db.Char(1)
  prioridade      String?   @map("Prioridade") @db.Char(1)
  dataAbertura    DateTime? @map("DataAbertura") @db.DateTime
  dataFechamento  DateTime? @map("DataFechamento") @db.DateTime
  dataAgenda      DateTime? @map("DataAgenda") @db.DateTime
  observacoes     String?   @map("Observações") @db.NVarChar(4000)
  orcamento       Int?      @map("Orçamento")
  empresa         Int?      @map("Empresa")
  unidade         Int?      @map("Unidade")

  @@map("OSs")
}

// ============================================================
// PréOrçamento (Pre-budget templates)
// ============================================================

model PreOrcamento {
  codInterno          Int      @id @map("CodInterno")
  descricao           String?  @map("Descrição") @db.NVarChar(200)
  unidade             Int?     @map("Unidade")
  observacoes         String?  @map("Observações") @db.NVarChar(4000)
  valorMensalVenda    Decimal? @map("ValorMensalVenda") @db.Decimal(18, 2)
  valorMensalComodato Decimal? @map("ValorMensalComodato") @db.Decimal(18, 2)
  ampliacao           Boolean? @map("Ampliação")
  limitePontos        Int?     @map("LimitePontos")
  valorPontoAdicional Decimal? @map("ValorPontoAdicional") @db.Decimal(18, 2)
  valorCrea           Decimal? @map("ValorCrea") @db.Decimal(18, 2)

  // Relations
  produtos            PreOrcamentoProduto[]

  @@map("PréOrçamento")
}

model PreOrcamentoProduto {
  codInterno      Int      @id @map("CodInterno")
  codPreOrcamento Int      @map("CodPréOrçamento")
  codProduto      Int?     @map("CodProduto")
  descricao       String?  @map("Descrição") @db.NVarChar(200)
  quantidade      Decimal? @map("Quantidade") @db.Decimal(18, 2)
  grupoOrcamento  String?  @map("GrupoOrçamento") @db.NVarChar(50)
  orcOrdem        Int?     @map("OrcOrdem")

  // Relations
  preOrcamento    PreOrcamento @relation(fields: [codPreOrcamento], references: [codInterno], onDelete: NoAction, onUpdate: NoAction)
  produto         Produto?     @relation(fields: [codProduto], references: [codProduto], onDelete: NoAction, onUpdate: NoAction)

  @@map("PréOrçamentoProdutos")
}

// ============================================================
// Senhas (Users / Operators)
// ============================================================

model SenhaUser {
  idUsuario       Int      @id @map("IDUsuário")
  usuario         String   @map("Usuário") @db.NVarChar(50)
  senhaSis        String   @map("Senhasis") @db.NVarChar(100)
  identificacao   String?  @map("Identificação") @db.NVarChar(200)
  usuarioInativo  Boolean? @map("UsuárioInativo")
  empresa         Int?     @map("Empresa")
  funcionario     Int?     @map("Funcionário")
  acessoCompleto  Boolean? @map("AcessoCompleto")
  dataCadastro    DateTime? @map("DataCadastro") @db.DateTime

  @@map("Senhas")
}
